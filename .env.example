# Copy to .env and fill in. .env is gitignored.

# HTTP port for the Web UI
PORT=8721

# Local proxy. REQUIRED — claude headless child processes need this to reach api.anthropic.com.
HTTP_PROXY=http://127.0.0.1:10808
HTTPS_PROXY=http://127.0.0.1:10808
NO_PROXY=localhost,127.0.0.1

# Path to the `claude` CLI binary. Leave empty to use $PATH lookup.
CLAUDE_BIN=

# Sibling project directory — where the actual R/H/execB/testC work happens.
# claude child processes spawn with this as cwd, so they read the sibling's
# .claude/commands/*.md (role skills), CLAUDE.md, doc/queue/, etc.
# In Phase 1 (single-instance observer) we don't need this yet, so leaving blank
# falls back to this project's own directory.
SIBLING_PROJECT_DIR=

# Log verbosity for backend: error | warn | info | debug
LOG_LEVEL=info
